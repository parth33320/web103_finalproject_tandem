# Copy to .env for local development. On Render, set these in the service's Environment tab.
PORT=3001
DATABASE_URL=postgres://your_user:your_password@localhost:5432/tandem
# The website's address (comma-separate several). The first one is where GitHub sign-in returns to.
CLIENT_ORIGIN=http://localhost:5173

# GitHub OAuth app (github.com/settings/developers). Callback URL: <this server>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# This server's public address. Render fills RENDER_EXTERNAL_URL automatically, so you only need this locally.
SERVER_URL=http://localhost:3001

# Signs sign-in tokens. Use a long random string and keep it the same between deploys.
SESSION_SECRET=change-me-to-a-long-random-string
# Password for the Admin page's "Reset database" button.
ADMIN_KEY=change-me
# Net votes a community word needs before it is dealt in games (the author's own vote counts).
APPROVE_AT=2
